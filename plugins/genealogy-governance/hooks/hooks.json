{
  "description": "Thin wrappers that run the genealogy clone's .claude/hooks scripts in place. Mirrors genealogy/.claude/settings.json minus PreCompact.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/run-genealogy-hook.py\" governance-arrival.sh", "timeout": 15 },
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/run-genealogy-hook.py\" journal-last-entry.sh", "timeout": 15 },
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/run-genealogy-hook.py\" compact-recovery.mjs", "timeout": 20 },
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/run-genealogy-hook.py\" --install-git-hooks", "timeout": 15 }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/run-genealogy-hook.py\" task-completed-qc.py", "timeout": 15 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/run-genealogy-hook.py\" subagent-start-governance.sh", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/run-genealogy-hook.py\" governance-concern-handler.sh", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/run-genealogy-hook.py\" research-write-guard.py", "timeout": 10 }
        ]
      }
    ]
  }
}
